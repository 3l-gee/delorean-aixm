<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.delorean-aixm</groupId>
        <artifactId>delorean-aixm</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

	<artifactId>delorean-aixm-52</artifactId>
    <packaging>jar</packaging>
    <name>Delorean AIXM 5.2</name>

    <dependencies>
        <!-- Delorean core -->
        <dependency>
            <groupId>com.delorean-aixm</groupId>
            <artifactId>delorean-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>com.delorean-aixm</groupId>
            <artifactId>post-jaxb</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- JPA Dependencies -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${annotation.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jpa-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- HiSrc Runtime Dependencies -->
		<dependency>
			<groupId>org.patrodyne.jvnet</groupId>
			<artifactId>hisrc-basicjaxb-runtime</artifactId>
			<version>${hisrc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.patrodyne.jvnet</groupId>
			<artifactId>hisrc-hyperjaxb-ejb-runtime</artifactId>
			<version>${hisrc.version}</version>
		</dependency>
        <dependency>
            <groupId>org.patrodyne.jvnet</groupId>
            <artifactId>hisrc-hyperjaxb-opt-hibernate</artifactId>
            <version>${hisrc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>${jakarta-xml-bind.version}</version>
        </dependency>

        <!-- Database Dependencies -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
		</dependency>
        <dependency>
            <groupId>net.postgis</groupId>
            <artifactId>postgis-jdbc</artifactId>
            <version>${postgis.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>9.0.1.Final</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
            <version>${hibernate.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-hikaricp</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- Hibernate Validator dependencies -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>6.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.expressly</groupId>
            <artifactId>expressly</artifactId>
            <version>6.0.0</version>
        </dependency>

        <!-- SLF4J Implementation -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.classic}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>2.0.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xmlunit</groupId>
            <artifactId>xmlunit-core</artifactId>
            <version>2.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xmlunit</groupId>
            <artifactId>xmlunit-assertj</artifactId>
            <version>2.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- JSON serialisation-->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-jaxb-annotations</artifactId>
            <version>2.20.1</version>
        </dependency>
    </dependencies>

    <build>
		<plugins>

            <!-- Unit Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.tags.include=${junit.jupiter.tags.include}
                        </configurationParameters>
                    </properties>
                    <systemPropertyVariables>
                        <junit.platform.properties>src/test/resources/unit-junit-platform.properties</junit.platform.properties>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Integration / End-to-End Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*E2E.java</include>
                    </includes>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.tags.include=${junit.jupiter.tags.include}
                        </configurationParameters>
                    </properties>
                </configuration>
            </plugin>

            <plugin>
				<artifactId>maven-site-plugin</artifactId>
				<version>4.0.0-M12</version>
			</plugin>

            <!-- Exec Maven Plugin -->
            <plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<mainClass>com.delorean.aixm.Main</mainClass>
					<cleanupDaemonThreads>false</cleanupDaemonThreads>
				</configuration>
            </plugin>

            <!-- Dependency analysis: suppress known runtime/SPI false positives -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <usedDependencies>
                        <usedDependency>jakarta.annotation:jakarta.annotation-api</usedDependency>
                        <usedDependency>com.zaxxer:HikariCP</usedDependency>
                        <usedDependency>org.hibernate.orm:hibernate-hikaricp</usedDependency>
                        <usedDependency>org.hibernate.orm:hibernate-spatial</usedDependency>
                        <usedDependency>org.hibernate.validator:hibernate-validator</usedDependency>
                        <usedDependency>jakarta.el:jakarta.el-api</usedDependency>
                        <usedDependency>org.glassfish.expressly:expressly</usedDependency>
                        <usedDependency>org.patrodyne.jvnet:hisrc-hyperjaxb-opt-hibernate</usedDependency>
                        <usedDependency>org.postgresql:postgresql</usedDependency>
                        <usedDependency>net.postgis:postgis-jdbc</usedDependency>
                        <usedDependency>org.slf4j:slf4j-simple</usedDependency>
                        <usedDependency>org.junit.jupiter:junit-jupiter-engine</usedDependency>
                        <usedDependency>org.xmlunit:xmlunit-core</usedDependency>
                        <usedDependency>org.xmlunit:xmlunit-assertj</usedDependency>
                    </usedDependencies>
                </configuration>
            </plugin>
        </plugins>
	</build>

    <profiles>
        <profile>
            <id>jaxb-52</id>
            <build>
                <plugins>

                     <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>

                            <!-- Pre-JAXB Source preparation -->
                            <execution>
                                <id>prepare aixm 52 bindings source</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.parent.basedir}/.venv/Scripts/python.exe</executable>
                                    <arguments>
                                        <argument>${project.parent.basedir}/pre-jaxb/jaxb_cli.py</argument>
                                        <argument>--schema</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-schema_a52.yaml</argument>
                                        <argument>--config</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-config_a52.yaml</argument>
                                        <argument>--content</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-content_a52.yaml</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- Queries generation -->
                            <execution>
                                <id>generate aixm 52 sql</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.parent.basedir}/.venv/Scripts/python.exe</executable>
                                    <arguments>
                                        <argument>${project.parent.basedir}/pre-jaxb/sql_cli.py</argument>
                                        <argument>--schema</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-schema_a52.yaml</argument>
                                        <argument>--config</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-config_a52.yaml</argument>
                                        <argument>--path_to_bmm</argument>
                                        <argument>${project.basedir}/src/main/resources/sql/query-basic-message-member-ids.sql</argument>
                                        <argument>--path_to_tsp</argument>
                                        <argument>${project.basedir}/src/main/resources/sql/query-time-slice-property-ids.sql</argument>
                                        <argument>--path_to_sfl</argument>
                                        <argument>${project.basedir}/src/main/resources/sql/schema_feature_list.txt</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            
                            <!-- Post-JAXB generated code Fix -->
                            <execution>
                                <id>postprocess aixm 51 bindings</id>
                                <phase>process-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <arguments>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>com.delorean.aixm.postjaxb.PostJAXBRunner</argument>
                                        <argument>${project.basedir}/src/main/post-jaxb/post-jaxb-config_a52.yaml</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- View generation -->
                            <execution>
                                <id>generate aixm 52 views</id>
                                <phase>process-sources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.parent.basedir}/.venv/Scripts/python.exe</executable>
                                    <arguments>
                                        <argument>${project.parent.basedir}/post-jaxb/view_cli.py</argument>
                                        <argument>--config</argument>
                                        <argument>${project.basedir}/src/main/pre-jaxb/pre-jaxb-config_a52.yaml</argument>
                                        <argument>--output_view_sql</argument>
                                        <argument>${project.basedir}/src/main/resources/sql/delorean-aixm-view.sql</argument>
                                        <argument>--output_materialized_sql</argument>
                                        <argument>${project.basedir}/src/main/resources/sql/delorean-aixm-materialized.sql</argument>
                                        <argument>--directory</argument>
                                        <argument>${project.basedir}/src/main/java/com/delorean/aixm/aixm52/schema</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- HiSrc HyperJAXB Code Generation -->
                    <plugin>
                        <groupId>org.patrodyne.jvnet</groupId>
                        <artifactId>hisrc-hyperjaxb-maven-plugin</artifactId>
                        <version>${hisrc.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.delorean-aixm</groupId>
                                <artifactId>delorean-core</artifactId>
                                <version>${project.parent.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.patrodyne.jvnet</groupId>
                                <artifactId>hisrc-hyperjaxb-annox-plugin</artifactId>
                                <version>${hisrc.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>generate aixm 52 bindings</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <noFileHeader>true</noFileHeader>
                                    <extension>true</extension>
                                    <schemaDirectory>${project.basedir}/src/main/schema/message</schemaDirectory>
                                    <schemaIncludes>
                                        <include>AIXM_BasicMessage.xsd</include>
                                    </schemaIncludes>
                                    <bindingDirectory>${project.basedir}/src/main/schema/bindings</bindingDirectory>
                                    <bindingIncludes>
                                        <include>*.xjb</include>
                                    </bindingIncludes>
                                    <generateDirectory>${project.basedir}/src/main/java</generateDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Spotless Code Formatter -->
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <version>2.43.0</version>
                        <executions>
                            <execution>
                                <id>format-generated-sources</id>
                                <phase>verify</phase> 
                                <goals>
                                    <goal>apply</goal> 
                                </goals>
                                <configuration>
                                    <java>
                                        <includes>
                                            <include>src/main/java/com/aixm/delorean/aixm52/schema/**/*.java</include>
                                        </includes>
                                        <eclipse>
                                            <version>4.29</version>
                                        </eclipse>
                                        <indent>
                                            <spaces>true</spaces>
                                            <spacesPerTab>4</spacesPerTab> 
                                        </indent>
                                        <endWithNewline/>
                                        <trimTrailingWhitespace/>
                                        <removeUnusedImports/>
                                        <importOrder/>
                                    </java>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
