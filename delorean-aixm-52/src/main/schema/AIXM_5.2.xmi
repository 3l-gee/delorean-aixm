					<attribute xmi:idref="EAID_4FDEE946_FF20_45cd_BE44_CDB753E4118A" name="RWY_INT_HOLD" scope="Public">
						<initial/>
						<documentation value="The inscription on a holding position sign at a taxiway/runway intersection is the runway number(s), such as “15-33”. The runway numbers are separated by a dash, and their arrangement indicates the direction to the corresponding runway threshold.  Source: FAA AC 150/5340-18G."/>
						<model ea_localid="33" ea_guid="{4FDEE946-FF20-45cd-BE44-CDB753E4118A}"/>
