						<documentation value="An Inbound destination sign for areas set aside for passenger handling. Source: FAA AC 150/5340-18G."/>
						<model ea_localid="28" ea_guid="{3ACCE062-B2FA-41bb-8995-98DA394AE3D6}"/>
