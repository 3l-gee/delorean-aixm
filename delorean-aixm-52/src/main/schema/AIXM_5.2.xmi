			<element xmi:idref="EAPK_CD9A349B_FD8B_446e_82C3_EF61E9DA9A8F" xmi:type="uml:Package" name="AIXM 5.2" scope="public">
				<model package2="EAID_CD9A349B_FD8B_446e_82C3_EF61E9DA9A8F" package="EAPK_7F712EA6_FB74_4aba_8C11_4774CA98580B" tpos="0" ea_localid="4" ea_eleType="package"/>
				<properties documentation="This package contains definitions of aeronautical information features and their properties, associations, lists of values and business rules in the form of an UML class model, which are part of the 'core' model.&#xA;&#xA;The scope of the AIXM core model goes beyond the information currently published by AIS by including information concepts such as those likely to be used by new applications (for example, airport mapping databases). It also includes concepts that are important for military users, such as military training routes and refueling areas. &#xA;&#xA;Only feature definitions that have been identified by the Design Team as being applicable world-wide have been included in the core model.&#xA;" isSpecification="false" sType="Package" nType="0" alias="urn:aero:aixm" scope="public"/>
				<project created="2010-02-12 08:11:46" modified="2022-10-28 08:34:34" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
