						<initial/>
						<documentation value="This sign is located to clearly identify the runways for pilots and only contains the runway designation for the one runway end.   Source: ICAO Annex 14."/>
						<model ea_localid="34" ea_guid="{404D0F0E-5A46-4695-A891-42CF3602270F}"/>
						<properties type="string" derived="0" collection="false" static="0" duplicates="0" changeability="changeable"/>
