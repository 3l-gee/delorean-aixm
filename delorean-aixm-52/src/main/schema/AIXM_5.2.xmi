				<properties documentation="Classification of aircraft that provides a standardised basis for relating aircraft manoeuvrability to specific instrument approach procedures, according to PANS-OPS, VOL II, Part 1, Section 4 or to supplementary military standards." isSpecification="false" sType="Class" nType="0" alias="urn:aero:aixm:CodeAircraftLandingCategoryBaseType:5.2" scope="public" stereotype="CodeList" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project created="2010-02-12 08:11:51" modified="2023-09-28 09:47:05" complexity="1" status="Proposed"/>
				<code/>
