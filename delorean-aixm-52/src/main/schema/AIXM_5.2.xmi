							<tag xmi:id="EAID_3573F212_0F10_4eff_8749_FBB9211A1A2E" name="URN" value="urn:aero:aixm:CodeRadarServiceBaseType#PAR:5.2"/>
							<tag xmi:id="EAID_06595786_57FD_4643_8FFB_828C75038EE2" name="URNprevious" value="urn:aero:aixm:CodeRadarServiceBaseType#PAR:5.1.1"/>
						</tags>
						<xrefs value="$XREFPROP=$XID={3C6C5827-1046-43ea-A8BF-E30AA1742E16}$XID;$NAM=CustomProperties$NAM;$TYP=attribute property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=isID@ENDNAME;@TYPE=Boolean@ENDTYPE;@VALU=0@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={F473FA74-C553-49db-B234-18FEE1732D67}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
					</attribute>
					<attribute xmi:idref="EAID_A040CCFF_B802_4ffd_94B2_04E9EBBD3273" name="ARSR" scope="Public">
						<initial/>
						<documentation value="Air Route Surveillance Radar&#xA;&#xA;Air Route Surveillance Radar (ARSR) or Route Surveillance Radar (RSR) is a system of remotely located, long-range radars that primarily provides a display of aircraft locations over large areas to air route traffic control centres"/>
						<model ea_localid="2231" ea_guid="{A040CCFF-B802-4ffd-94B2-04E9EBBD3273}"/>
						<properties type="string" derived="0" precision="0" collection="false" length="0" static="0" changeability="changeable"/>
