					<attribute xmi:idref="EAID_B587554E_7FFF_4e13_93BD_0F54771D2134" name="FAIR" scope="Public">
						<initial/>
						<documentation value="Some cracking and raveling. Cracks are generally spaced less than 15 m (50 feet) apart. Joint and crack sealing is needed on 10% to 25% of the cracks and joints. There is isolated alligator cracking, the patches are in poor condition, and/or there are crack settlements up to 2.5 cm (1 inch)."/>
						<model ea_localid="2697" ea_guid="{B587554E-7FFF-4e13-93BD-0F54771D2134}"/>
						<properties type="string" derived="0" precision="0" collection="false" length="0" static="0" changeability="changeable"/>
