			<element xmi:idref="EAPK_A6BA0393_FF2B_4886_9F7F_3E7117731152" xmi:type="uml:Package" name="AIXM Data Types" scope="public">
				<model package2="EAID_A6BA0393_FF2B_4886_9F7F_3E7117731152" package="EAPK_CD9A349B_FD8B_446e_82C3_EF61E9DA9A8F" tpos="0" ea_localid="6" ea_eleType="package"/>
				<properties documentation="Package containing the DataTypes that are used throughout the AIXM.&#xA;&#xA;There are two different stereotypes used to qualify the AIXM DataTypes: &#xA;&amp;lt;&amp;lt;DataType&amp;gt;&amp;gt; This is a basic data type that specifies a pattern to use.&#xA;&amp;lt;&amp;lt;CodeList&amp;gt;&amp;gt; This is a data type which codes a predefined list of values. &#xA;All code lists include the value ‘OTHER’ which can be expanded with some free text in uppercase (‘OTHER:MY_VALUE’) to support coded values not defined in the current model version. The OTHER value is also important for mapping future changes to the list. If a value is added in the future and is not recognised by the current enumeration, it is mapped to the OTHER value." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project created="2010-02-12 08:11:46" modified="2023-08-01 11:44:22" complexity="1" status="Proposed"/>
