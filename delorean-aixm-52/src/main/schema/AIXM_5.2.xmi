					<attribute xmi:idref="EAID_6E542E58_2506_4c57_988D_8E8CBE9149AF" name="POOR" scope="Public">
						<initial/>
						<documentation value="Widespread, open, unsealed cracks and joints. There are cracks over 1 cm (&amp;#189;-inch) wide with raveling in 25% of the cracks. Cracks are generally spaced 1.5 m to 15 m (5 to 50 feet) apart with surface and slab spalling. Alligator cracking or patches are in poor condition and cover up to 20% of the surface or there is vegetation through the cracks and joints."/>
						<model ea_localid="2698" ea_guid="{6E542E58-2506-4c57-988D-8E8CBE9149AF}"/>
