					<attribute xmi:idref="EAID_02578C5C_490A_494f_A6C6_8DB8E9568B59" name="RWY_DIST_REMAIN" scope="Public">
						<initial/>
						<documentation value="Runway distance remaining signs are used to provide distance remaining information to pilots during takeoff and landing operations. The sign has a white numeral inscription on a black background. Source: FAA AC 150/5340-18G."/>
						<model ea_localid="31" ea_guid="{02578C5C-490A-494f-A6C6-8DB8E9568B59}"/>
