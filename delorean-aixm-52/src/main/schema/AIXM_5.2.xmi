					<attribute xmi:idref="EAID_F881F33E_78F9_4cc1_9B5C_6A733238A5AF" name="RWY_EXIT" scope="Public">
						<initial/>
						<documentation value="A runway exit sign shall be provided where there is an operational need to identify a runway exit.  The inscription on a runway exit sign shall consist of the designator of the exit taxiway and an arrow indicating the direction to follow.  Source: ICAO Annex 14."/>
						<model ea_localid="32" ea_guid="{F881F33E-78F9-4cc1-9B5C-6A733238A5AF}"/>
						<properties type="string" derived="0" collection="false" static="0" duplicates="0" changeability="changeable"/>
