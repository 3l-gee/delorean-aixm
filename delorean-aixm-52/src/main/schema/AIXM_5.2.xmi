					<attribute xmi:idref="EAID_2C46A9AA_9A56_43e9_B974_B8E78FA93790" name="OUTBOUND_DEST" scope="Public">
						<initial/>
						<documentation value="Outbound destination signs identify directions to takeoff runways. These routes usually begin at the entrance to a taxiway from an apron area. The inscription is the runway number plus an arrow indicating the direction. More than one runway number, separated by a dot, may be shown where the taxiing route is common to both runways. The outbound destination sign should always direct the pilot to the beginning of a takeoff runway. Source: FAA AC 150/5340-18G."/>
						<model ea_localid="27" ea_guid="{2C46A9AA-9A56-43e9-B974-B8E78FA93790}"/>
						<properties type="string" derived="0" collection="false" static="0" duplicates="0" changeability="changeable"/>
