							<tag xmi:id="EAID_2E066373_266E_4b34_8EAF_D25B18327CF9" name="URN" value="urn:aero:aixm:CodeRadarServiceBaseType#ASR:5.2"/>
							<tag xmi:id="EAID_6F17BB19_D058_42ba_8E5B_25D7751CDB8D" name="URNprevious" value="urn:aero:aixm:CodeRadarServiceBaseType#ASR:5.1.1"/>
						</tags>
						<xrefs value="$XREFPROP=$XID={C59714AE-B9F6-4ae4-888C-5CF0F6134347}$XID;$NAM=CustomProperties$NAM;$TYP=attribute property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=isID@ENDNAME;@TYPE=Boolean@ENDTYPE;@VALU=0@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={B9FD6770-BBC2-4abb-B375-05A0821A50A7}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
