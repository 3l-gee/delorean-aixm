			<element xmi:idref="EAPK_462B1D4B_41C2_474f_A5B0_BFEB729FDE7E" xmi:type="uml:Package" name="Flight restrictions" scope="public">
				<model package2="EAID_462B1D4B_41C2_474f_A5B0_BFEB729FDE7E" package="EAPK_17FEF7F4_0CD8_4962_80A8_ED113D5D0243" tpos="0" ea_localid="48" ea_eleType="package"/>
				<properties documentation="This package contains the classes that model traffic flow and similar flight restrictions.&#xA;&#xA;Certain restrictions can be encoded as both RoutePortionUsage and FlightRestrictsions. The following criteria should be used in order to distinguish between the two:&#xA;- RoutePortionUsage restrictions should be used for all restrictions that are from point to point and which depend on time and eventually aircraft characteristics (such as navaid equipment, propulsion type, etc.).&#xA;- Flight Restrictions (also named &quot;traffic flow restrictions&quot;) should be used for those restrictions that depend on flight origin/destination and eventually on type (civil, military, scheduled, etc.)." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project created="2010-02-12 08:12:03" modified="2010-02-12 08:12:03"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
