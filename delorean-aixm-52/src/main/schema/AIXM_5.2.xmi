					<attribute xmi:idref="EAID_DE3F6FB1_25C0_49f3_B08A_DF4CC4D59F79" name="MIL_HOLD" scope="Public">
						<initial/>
						<documentation value="The inscription on a holding position sign located at the intersection of a taxiway or designated runway and a military landing zone/assault strip that does not have a runway designation is: “MIL LZ”.  Source: FAA AC 150/5340-18G."/>
						<model ea_localid="25" ea_guid="{DE3F6FB1-25C0-49f3-B08A-DF4CC4D59F79}"/>
