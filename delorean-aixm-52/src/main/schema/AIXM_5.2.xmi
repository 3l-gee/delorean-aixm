					<attribute xmi:idref="EAID_0035DCE6_B786_4704_85C6_09256C627CFD" name="NO_ENTRY" scope="Public">
						<initial/>
						<documentation value="A NO ENTRY sign shall be provided when entry into an area is prohibited. A NO ENTRY sign shall be located at the beginning of the area to which entrance is prohibited on each side of the taxiway as viewed by the pilot. Source: ICAO Annex 14."/>
						<model ea_localid="26" ea_guid="{0035DCE6-B786-4704-85C6-09256C627CFD}"/>
						<properties type="string" derived="0" collection="false" static="0" duplicates="0" changeability="changeable"/>
