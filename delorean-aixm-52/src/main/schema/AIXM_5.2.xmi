				<attributes>
					<attribute xmi:idref="EAID_F473FA74_C553_49db_B234_18FEE1732D67" name="PAR" scope="Public">
						<initial/>
						<documentation value="Precision Approach Radar&#xA;&#xA;Precision Approach Radar (PAR) is designed for use as a landing aid rather than an aid for sequencing and spacing aircraft to provide lateral and vertical guidance to an aircraft pilot for landing up to the missed approach point.  PAR equipment may be used as a primary landing aid or it may be used to monitor other types of approaches.  It is designed to display range, azimuth, and elevation information.  It is similar to an instrument landing system (ILS) but requires control instructions.  One type of instrument approach that can make use of PAR is the ground-controlled approach (GCA)."/>
						<model ea_localid="2230" ea_guid="{F473FA74-C553-49db-B234-18FEE1732D67}"/>
						<properties type="string" derived="0" precision="0" collection="false" length="0" static="0" changeability="changeable"/>
						<coords ordered="0" scale="0"/>
						<containment position="0"/>
						<stereotype/>
