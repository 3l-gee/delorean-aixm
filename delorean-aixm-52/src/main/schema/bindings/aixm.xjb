          <orm:join-column name="message_hjid" referenced-column-name="hjid"/>
          <orm:inverse-join-column name="member_hjid" referenced-column-name="hjid"/>
        </orm:join-table>
      </hj:many-to-many>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='BasicMessageMemberAIXMPropertyType']">
      <annox:annotate target="class">@org.hibernate.annotations.FilterDef(name = "BMMHjidFilter", parameters = @org.hibernate.annotations.ParamDef(name = "ids", type = Long.class))</annox:annotate>
      <annox:annotate target="class">@org.hibernate.annotations.Filter(name = "BMMHjidFilter", condition = "hjid IN (:ids)")</annox:annotate>
      <hj:entity>
        <orm:table name="message_member" schema="aixm"/>
      </hj:entity>
    </jaxb:bindings>
    <!-- section : auto -->
    <!-- part : default -->
  </jaxb:bindings>
</jaxb:bindings>
