					<attribute xmi:idref="EAID_2C010558_693B_4972_9606_D69345C09806" name="flyOver" scope="Public">
						<initial/>
						<documentation value="Indicates if the aircraft is required to fly directly over the fix. If code is Yes, then it is a 'fly-over' waypoint. If the code is No, then the associated fix is a 'fly-by' waypoint. [ICAO] Waypoints are identified as either flyover or fly-by.&#xA;&#xA;Fly-by waypoint. A waypoint which requires turn anticipation to allow tangential interception of the next segment of a route or procedure&#xA;&#xA;Flyover waypoint. A waypoint at which a turn is initiated in order to join the next segment of a route or procedure."/>
						<model ea_localid="3651" ea_guid="{2C010558-693B-4972-9606-D69345C09806}"/>
