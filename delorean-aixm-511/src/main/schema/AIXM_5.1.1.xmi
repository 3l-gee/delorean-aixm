					<attribute xmi:idref="EAID_1E44766E_EE94_48eb_AA2F_6F3BBA64DE55" name="rnpDMEAuthorized" scope="Public">
						<initial/>
						<documentation value="Applies to RNAVguidance.  Indicates if DME/DME RNP 0.3 is allowed.&#xA;&#xA;DME/DME based RNP-.03 systems may be used only when a chart note indicates DME/DME availability, for example, &quot;DME/DME RNP-0.3 Authorized.&quot; Specific DME facilities may be required, for example, &quot;DME/DME RNP-0.3 Authorized, ABC, XYZ required.&quot;&#xA;&#xA;Note: Used on RNAV final segment."/>
						<model ea_localid="3813" ea_guid="{1E44766E-EE94-48eb-AA2F-6F3BBA64DE55}"/>
