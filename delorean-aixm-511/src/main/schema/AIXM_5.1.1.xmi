			<element xmi:idref="EAID_05ADEB91_A145_4191_9D66_BAC29C35103A" xmi:type="uml:Class" name="NavaidComponent" scope="public">
				<model package="EAPK_C9F89692_94EE_447b_83E1_ABA679028E67" tpos="0" ea_localid="742" ea_eleType="element"/>
				<properties documentation="Indicates navigation use of a NavaidEquipment as a component of the navigation service provided by a Navaid. &#xA;&#xA;For example the DME NavaidEquipment is a NavaidComponent of an ILS system.  The DME may be collocated with the Localizer and the DME may provide the navigable location for the Navaid service.&#xA;" isSpecification="false" sType="Class" nType="17" scope="public" stereotype="object" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
