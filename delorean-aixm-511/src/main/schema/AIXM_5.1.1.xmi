			<element xmi:idref="EAPK_A6BA0393_FF2B_4886_9F7F_3E7117731152" xmi:type="uml:Package" name="AIXM Data Types" scope="public">
				<model package2="EAID_A6BA0393_FF2B_4886_9F7F_3E7117731152" package="EAPK_CD9A349B_FD8B_446e_82C3_EF61E9DA9A8F" tpos="0" ea_localid="430" ea_eleType="package"/>
				<properties documentation="Package containing the DataTypes that are used throughout the AIXM. &#xA;&#xA;There are three different types of DataTypes: &#xA;- DataType - This is basic data type that specifies a pattern to use.&#xA;- enumeration - This codes a fixed list of values. The OTHER value is important for mapping future changes to the list. If a value is added in the future and is not recognised by the current enumeration, it is mapped to the OTHER value.&#xA;- CodeList - This is similar to an enumeration in that it is used to indicate a list of possible values. However, the list can be expanded, which means that the CodeList is a union between the explicitly enumerated values and free text." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project created="2010-02-12 08:11:46" modified="2015-03-24 10:55:41" complexity="1" status="Proposed"/>
				<code/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
