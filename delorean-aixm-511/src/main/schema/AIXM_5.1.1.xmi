					<attribute xmi:idref="EAID_0124E118_8FFA_49f9_B1C0_1689AD224A68" name="FROP" scope="Public">
						<initial/>
						<documentation value="Final Rollout Point - Where a course change is required within the Final Approach Segment (FAS), the point that the aircraft rolls to a wings-level attitude aligned with the runway centreline extended is considered the FROP.&#xA;&#xA;FROP is used in an RNP-SAAAR procedure when a turn is required in the final between the FAF and the threshold."/>
						<model ea_localid="321" ea_guid="{0124E118-8FFA-49f9-B1C0-1689AD224A68}"/>
						<properties type="string" derived="0" precision="0" collection="false" length="0" changeability="changeable"/>
						<coords ordered="0" scale="0"/>
