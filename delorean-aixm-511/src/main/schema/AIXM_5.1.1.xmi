				<xrefs value="$XREFPROP=$XID={7C206A66-FC3A-45cc-82FA-956CBF1D54B6}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=object;FQName=Delphi::object;@ENDSTEREO;$DES;$CLT={05ADEB91-A145-4191-9D66-BAC29C35103A}$CLT;$ENDXREF;$XREFPROP=$XID={C5BE83F6-49AB-4bb9-82B2-1395B0717E9B}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=isActive@ENDNAME;@TYPE=Boolean@ENDTYPE;@VALU=@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={05ADEB91-A145-4191-9D66-BAC29C35103A}$CLT;$ENDXREF;"/>
