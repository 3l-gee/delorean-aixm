				<attributes>
					<attribute xmi:idref="EAID_DA331CC4_84F9_4333_9629_596C59F4C177" name="collocationGroup" scope="Public">
						<initial/>
						<documentation value="Set of navaid equipments that are collocated.  All Navaid equipment that has the same value for this property are collocated together.  For example in a VOR/DME Navaid the VOR and DME navaid equipment will be assigned the same collocationGroup number = 1.  For example an ILS might have a Localizer with collocation Group number = 1 and collocated DME and Glidepath sharing collocationGroup number = 2.  "/>
						<model ea_localid="3541" ea_guid="{DA331CC4-84F9-4333-9629-596C59F4C177}"/>
						<properties type="NoSequenceType" derived="0" precision="0" collection="false" length="0" changeability="changeable"/>
