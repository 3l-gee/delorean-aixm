						<initial/>
						<documentation value="A timber that has been impregnated with chemicals (for example: creosote oil) to reduce damage from wood rot and/or insects.  Often used for the portions of a structure that are likely to be in ongoing contact with soil and/or water."/>
						<model ea_localid="2956" ea_guid="{A516E23E-EFFB-41fb-9B3B-5A7950FEBE34}"/>
