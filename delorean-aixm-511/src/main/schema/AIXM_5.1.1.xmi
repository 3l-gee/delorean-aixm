					<attribute xmi:idref="EAID_B61629E4_6C3F_4b17_835E_78BBB9FC2EDE" name="magneticVariation" scope="Public">
						<initial/>
						<documentation value="The measured angle between Magnetic North and True North at the VOR and at the time reported in dateMagneticVariation. By convention, the measure is expressed as a positive number if Magnetic North is to the east of True North and negative if Magnetic North is to the west of True North. Therefore, magnetic bearing + magnetic variation = true bearing. The following rule of thumb applies: &quot;&quot;variation east-magnetic least, variation west-magnetic best&quot;&quot;."/>
						<model ea_localid="3558" ea_guid="{B61629E4-6C3F-4b17-835E-78BBB9FC2EDE}"/>
