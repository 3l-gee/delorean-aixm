					<attribute xmi:idref="EAID_3D860A40_C9DF_437a_88CF_AD8ADCA346EF" name="ASR" scope="Public">
						<initial/>
						<documentation value="Airport Surveillance Radar system.&#xA;&#xA;Airport Surveillance Radar (ASR) is a category of surveillance radars.  ASR is designed to provide relatively short-range coverage in the general vicinity of an airport and to serve as an expeditious means of handling terminal traffic through observation of precise aircraft locations on a radarscope.  The ASR can also be used as an instrument approach aid."/>
						<model ea_localid="356" ea_guid="{3D860A40-C9DF-437a-88CF-AD8ADCA346EF}"/>
						<properties type="string" derived="0" precision="0" collection="false" length="0" changeability="changeable"/>
